# ==============================================================================
# PromptWars Vault — Local Environment Configuration
# ==============================================================================
# Copy this file to .env:
#   copy backend\.env.example backend\.env
#
# 1. Your Google Gemini API Key from https://aistudio.google.com/app/apikey
DISPATCH_GEMINI_API_KEY=your-gemini-api-key-here

# 2. Ingest API Key (at least 32 characters, no spaces)
DISPATCH_INGEST_API_KEY=local-dev-key-at-least-thirty-two-chars

# 3. Gemini Model Identifier
DISPATCH_GEMINI_MODEL=gemini-2.5-flash

# 4. Production Origin (must be an https origin; http://localhost:3000 is automatically allowed)
DISPATCH_PRODUCTION_ORIGIN=https://localhost

# 5. Redis URL (optional if using run_local.py, required for production uvicorn)
DISPATCH_REDIS_URL=redis://localhost:6379/0
